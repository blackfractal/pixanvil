{
  "id":"qwen-image-edit", "version":1, "name":"Qwen Image Edit · Change an image by instruction", "description":"Edits an existing image from a plain instruction, such as \"make the cloak red\" or \"turn the background into a forest at night\". Needs a source image; the result keeps the source's shape at about one megapixel.",
  "family":"qwen", "media":"image", "emphasis":false, "negative":true,
  "sampler":"euler", "scheduler":"simple",
  "source_image":{"node":"input","input":"image"},
  "model_source":["UNETLoader","unet_name"], "model_contains":["qwen_image_edit"],
  "profiles":{"fast":{"steps":10,"cfg":4},"balanced":{"steps":20,"cfg":4},"quality":{"steps":30,"cfg":4},"maximum":{"steps":40,"cfg":4}},
  "bindings":{"model":[["unet","unet_name"]],"prompt":[["positive","prompt"]],"negative":[["negative","prompt"]],"seed":[["sampler","seed"]],"steps":[["sampler","steps"]],"cfg":[["sampler","cfg"]]},
  "graph":{
    "unet":{"class_type":"UNETLoader","inputs":{"unet_name":"","weight_dtype":"default"}},
    "shift":{"class_type":"ModelSamplingAuraFlow","inputs":{"model":["unet",0],"shift":3.1}},
    "cfg-norm":{"class_type":"CFGNorm","inputs":{"model":["shift",0],"strength":1}},
    "text-encoder":{"class_type":"CLIPLoader","inputs":{"clip_name":"qwen_2.5_vl_7b_fp8_scaled.safetensors","type":"qwen_image","device":"default"}},
    "vae":{"class_type":"VAELoader","inputs":{"vae_name":"qwen_image_vae.safetensors"}},
    "input":{"class_type":"LoadImage","inputs":{"image":"pixanvil/source.png"}},
    "input-size":{"class_type":"FluxKontextImageScale","inputs":{"image":["input",0]}},
    "positive":{"class_type":"TextEncodeQwenImageEditPlus","inputs":{"clip":["text-encoder",0],"vae":["vae",0],"image1":["input-size",0],"prompt":""}},
    "negative":{"class_type":"TextEncodeQwenImageEditPlus","inputs":{"clip":["text-encoder",0],"vae":["vae",0],"image1":["input-size",0],"prompt":""}},
    "positive-method":{"class_type":"FluxKontextMultiReferenceLatentMethod","inputs":{"conditioning":["positive",0],"reference_latents_method":"index_timestep_zero"}},
    "negative-method":{"class_type":"FluxKontextMultiReferenceLatentMethod","inputs":{"conditioning":["negative",0],"reference_latents_method":"index_timestep_zero"}},
    "encode":{"class_type":"VAEEncode","inputs":{"pixels":["input-size",0],"vae":["vae",0]}},
    "sampler":{"class_type":"KSampler","inputs":{"model":["cfg-norm",0],"positive":["positive-method",0],"negative":["negative-method",0],"latent_image":["encode",0],"seed":0,"steps":20,"cfg":4,"sampler_name":"euler","scheduler":"simple","denoise":1}},
    "decode":{"class_type":"VAEDecode","inputs":{"samples":["sampler",0],"vae":["vae",0]}},
    "save":{"class_type":"SaveImage","inputs":{"images":["decode",0],"filename_prefix":"PixAnvil"}}
  }
}
