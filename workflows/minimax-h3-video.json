{
  "id":"minimax-h3-video", "version":1, "name":"MiniMax H3 · Video", "description":"Video with stereo sound on the local MiniMax H3 model, from a prompt, optionally with a start image, an end image, or both, using its 8-step turbo LoRA. A 5-second clip takes a couple of minutes. No negative prompt.",
  "family":"minimax-h3", "media":"video", "emphasis":false, "negative":false,
  "sampler":"res_multistep", "scheduler":"simple",
  "defaults":{"width":832,"height":448,"frames":124,"fps":24},
  "frames":{"step":17,"offset":5,"min":56,"max":362},
  "start_image":{"node":"cond","input":"first_frame","pixels":500000},
  "end_image":{"node":"cond","input":"last_frame"},
  "durations":[{"seconds":3,"frames":73},{"seconds":5,"frames":124},{"seconds":8,"frames":192},{"seconds":10,"frames":243}],
  "canvases":[{"width":832,"height":448,"label":"Landscape · 832 × 448"},{"width":448,"height":832,"label":"Portrait · 448 × 832"},{"width":768,"height":768,"label":"Square · 768 × 768"},{"width":1344,"height":768,"label":"Native 16:9 · 1344 × 768 (slow)"}],
  "model_source":["UNETLoader","unet_name"], "model_contains":["minimax_h3_fl2va"],
  "profiles":{"fast":{"steps":8,"cfg":1},"balanced":{"steps":8,"cfg":1},"quality":{"steps":8,"cfg":1},"maximum":{"steps":8,"cfg":1}},
  "bindings":{"model":[["unet","unet_name"]],"prompt":[["cond","prompt"]],"width":[["cond","width"]],"height":[["cond","height"]],"frames":[["cond","length"]],"fps":[["video","fps"]],"seed":[["noise","noise_seed"]],"steps":[["sigmas","steps"]]},
  "graph":{
    "unet":{"class_type":"UNETLoader","inputs":{"unet_name":"","weight_dtype":"default"}},
    "turbo":{"class_type":"LoraLoaderModelOnly","inputs":{"model":["unet",0],"lora_name":"minimax_h3_fl2v_turbo_8step_v1.0_comfyui_bf16.safetensors","strength_model":1}},
    "text-encoder":{"class_type":"CLIPLoader","inputs":{"clip_name":"qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors","type":"minimax","device":"default"}},
    "video-vae":{"class_type":"VAELoader","inputs":{"vae_name":"minimax_h3_video_vae_int8_convrot.safetensors"}},
    "audio-vae":{"class_type":"VAELoader","inputs":{"vae_name":"minimax_h3_audio_vae_fp32.safetensors"}},
    "cond":{"class_type":"MiniMaxH3ImageToVideo","inputs":{"clip":["text-encoder",0],"vae":["video-vae",0],"prompt":"","width":832,"height":448,"length":124}},
    "sampler-select":{"class_type":"KSamplerSelect","inputs":{"sampler_name":"res_multistep"}},
    "sigmas":{"class_type":"BasicScheduler","inputs":{"model":["turbo",0],"scheduler":"simple","steps":8,"denoise":1}},
    "guider":{"class_type":"BasicGuider","inputs":{"model":["turbo",0],"conditioning":["cond",0]}},
    "noise":{"class_type":"RandomNoise","inputs":{"noise_seed":0}},
    "sampler":{"class_type":"SamplerCustomAdvanced","inputs":{"noise":["noise",0],"guider":["guider",0],"sampler":["sampler-select",0],"sigmas":["sigmas",0],"latent_image":["cond",1]}},
    "decode-video":{"class_type":"VAEDecode","inputs":{"samples":["sampler",0],"vae":["video-vae",0]}},
    "decode-audio":{"class_type":"VAEDecodeAudio","inputs":{"samples":["sampler",0],"vae":["audio-vae",0]}},
    "video":{"class_type":"CreateVideo","inputs":{"images":["decode-video",0],"audio":["decode-audio",0],"fps":24}},
    "save":{"class_type":"SaveVideo","inputs":{"video":["video",0],"filename_prefix":"video/PixAnvil","format":"auto","codec":"auto"}},
    "poster-frame":{"class_type":"ImageFromBatch","inputs":{"image":["decode-video",0],"batch_index":0,"length":1}},
    "poster":{"class_type":"SaveImage","inputs":{"images":["poster-frame",0],"filename_prefix":"PixAnvil_poster"}}
  }
}
